{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "히나 비서",
  "version": "1.3.1",
  "identifier": "com.msoffice.hina",
  "build": {
    "beforeDevCommand": "node scripts/serve.mjs",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "node scripts/build.mjs",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "MS 사무실 — 히나 비서",
        "width": 320,
        "height": 420,
        "transparent": true,
        "decorations": false,
        "shadow": false,
        "resizable": false,
        "skipTaskbar": true,
        "alwaysOnTop": true,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: data: blob:; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost https://api.github.com https://wnalstlr777.github.io/AI-Studio/shared/hina/assets/; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "shortDescription": "MS 사무실 QA 데스크톱 비서",
    "icon": [
      "icons/icon.png",
      "icons/icon.ico"
    ]
  }
}
